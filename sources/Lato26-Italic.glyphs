{
code = "# GSUB feature: Contextual Alternates
# Lookups: 2

  sub @calt2 Iota' lookup calt_ccmp_1;
  sub @calt3 Upsilon' lookup calt_ccmp_1;
  sub @calt' lookup calt_1_4 @calt4;
  sub @calt4 @calt' lookup calt_1_4;
