  script cyrl; # Cyrillic
    lookup cyrl { 
     sub breve by breve.cyrl;
     sub brevecomb by brevecomb.cyrl;
    } cyrl;
    language SRB ; # Serbian
    lookup cyrl_SRB { 
      sub be-cy by be-cy.cyrlSRB;
      #sub de-cy by de-cy.cyrlSRB;
      #sub te-cy by te-cy.cyrlSRB;
      #sub pe-cy by pe-cy.cyrlSRB;
    } cyrl_SRB;
    language BOS ; # Bosnian
    lookup cyrl_SRB;

  script grek; # Greek
    lookup grek {
      sub grave by varia;
      sub acute by oxia;
      sub gravecomb by variacomb;
      sub acutecomb by oxiacomb;
      sub commaabovecomb by psilicomb;
      sub commareversedabovecomb by dasiacomb;
    } grek;";
tag = locl;
},
